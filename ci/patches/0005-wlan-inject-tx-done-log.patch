+/*
+ * wlanInjectTxDoneHandler: INJECT ile gonderilen cercevenin gercek
+ * donanim/firmware tamamlanma durumunu loglar. nicTxProcessTxDoneEvent()
+ * basarili (ucStatus==0) tamamlanmayi yalnizca TRACE seviyesinde
+ * (normalde goruolmez) kaydeder; biz burada hem basari hem hata
+ * durumunu REQ/INFO seviyesinde, yani normal dmesg'te goruolur
+ * sekilde yazdiriyoruz. Sadece gozlem amacli, gonderimi etkilemez.
+ */
+static uint32_t wlanInjectTxDoneHandler(IN struct ADAPTER *prAdapter,
+					 IN struct MSDU_INFO *prMsduInfo,
+					 IN enum ENUM_TX_RESULT_CODE
+					 rTxDoneStatus)
+{
+	DBGLOG(REQ, INFO,
+	       "INJECT tx-done: status=%u (0=basarili, 0 disi=hata/kod)\n",
+	       (unsigned int) rTxDoneStatus);
+	return 0;
+}
