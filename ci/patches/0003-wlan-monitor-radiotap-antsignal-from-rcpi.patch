+	/* Bit Number 5 ANT SIGNAL
+	 * RxVector[3] bits 0-7 hold RCPI0; dBm = RCPI / 2 - 110.
+	 * RCPI > 220 (0xDC) is invalid -> report -128 dBm (radiotap "unknown").
+	 */
+	{
+		uint8_t ucRcpi = (uint8_t)(((prRxStatusGroup3)->u4RxVector[3] &
+			RX_VT_RCPI0_MASK) >> RX_VT_RCPI0_OFFSET);
+
+		if (ucRcpi <= 220)
+			rMonitorRadiotap.ucAntennaSignal =
+				(uint8_t)((ucRcpi >> 1) - 110);
+		else
+			rMonitorRadiotap.ucAntennaSignal = 0x80;
+	}
 
