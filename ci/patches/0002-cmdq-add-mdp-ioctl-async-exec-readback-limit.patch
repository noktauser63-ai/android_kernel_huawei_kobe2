+obj-y += mdp_ioctl_ex.o
+obj-y += mdp_m4u.o
diff --git a/drivers/misc/mediatek/mdp/mdp_def_ex.h b/drivers/misc/mediatek/mdp/mdp_def_ex.h
new file mode 100644
index 000000000..87ce255af
--- /dev/null
+++ b/drivers/misc/mediatek/mdp/mdp_def_ex.h
@@ -0,0 +1,177 @@
+/*
